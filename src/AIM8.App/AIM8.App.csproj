<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AIM8</AssemblyName>
    <RootNamespace>AIM8.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\overlay.js" LogicalName="AIM8.overlay.js" />
    <EmbeddedResource Include="Web\offline.html" LogicalName="AIM8.offline.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIM8.Core\AIM8.Core.csproj" />
  </ItemGroup>

</Project>
