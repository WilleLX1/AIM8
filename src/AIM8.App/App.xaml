<Application x:Class="AIM8.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIM8.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:StateBrushConverter x:Key="StateBrush" />
            <local:TriStateGlyphConverter x:Key="TriGlyph" />
            <local:TriStateBrushConverter x:Key="TriBrush" />
            <local:StringVisibilityConverter x:Key="StringVisibility" />
            <local:BoolVisibilityConverter x:Key="BoolVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
