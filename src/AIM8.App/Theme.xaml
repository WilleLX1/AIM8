<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: a dark console that stays readable next to a bright phone screen. -->
    <SolidColorBrush x:Key="Background" Color="#FF14161A" />
    <SolidColorBrush x:Key="Surface" Color="#FF1B1E24" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FF222630" />
    <SolidColorBrush x:Key="PanelBorder" Color="#FF2F3540" />

    <SolidColorBrush x:Key="Text" Color="#FFE6E9EF" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF8C94A3" />
    <SolidColorBrush x:Key="TextFaint" Color="#FF5C6373" />

    <SolidColorBrush x:Key="Accent" Color="#FF4C9AFF" />
    <SolidColorBrush x:Key="Success" Color="#FF3FB950" />
    <SolidColorBrush x:Key="Warning" Color="#FFD29922" />
    <SolidColorBrush x:Key="Danger" Color="#FFF85149" />
    <SolidColorBrush x:Key="Running" Color="#FF58A6FF" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style TargetType="TextBlock" x:Key="Label">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Value">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style TargetType="TextBlock" x:Key="PanelTitle">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Border" x:Key="Panel">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Button" x:Key="ToolButton">
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF2C323D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="#FF1F6FEB" />
        <Setter Property="BorderBrush" Value="#FF2D7FF9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style TargetType="TextBox" x:Key="Field">
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="CheckBox" x:Key="Check">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <SolidColorBrush x:Key="SolidsAccent" Color="#FFFFD23F" />
    <SolidColorBrush x:Key="StripesAccent" Color="#FF4CC9F0" />
    <SolidColorBrush x:Key="OpenAccent" Color="#FFB18CFF" />

    <!-- A big two-way choice: the Tag carries the accent shown when selected. -->
    <Style TargetType="RadioButton" x:Key="TeamToggle">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                            CornerRadius="8" Padding="10,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF2C323D" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Chrome" Property="Background" Value="#FF262B35" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" x:Key="SmallToggle" BasedOn="{StaticResource TeamToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF2C323D" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="Tune">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
